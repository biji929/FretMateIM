# Environment Variables Example for FretMate

# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production-please
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL on Supabase or any Postgres)
# Leave blank to fallback to SQLite (db.sqlite3)
# For Session Pooler (port 5432): DATABASE_URL=postgres://postgres.ref:password@aws-0-region.pooler.supabase.com:5432/postgres
# For Transaction Pooler (port 6543): add options if needed or configure CONN_MAX_AGE=0
DATABASE_URL=
